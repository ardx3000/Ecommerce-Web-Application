@{
    ViewData["Title"] = "Home Page";
}
@using System.Security.Claims

@{
    if (User.Identity.IsAuthenticated)
    {
        <button id="addJobButton" class="btn btn-primary btn-lg rounded-circle" style="position: fixed; bottom: 20px; right: 20px; background-color: #808080;">+</button>
    }
}

<link rel="stylesheet" type="text/css" href="~/Content/site.css" />
<h2>Job Posts</h2>

@foreach (var jobPost in Model)
{
    <div class="job-box">
        <h3>@jobPost.Title</h3>
        <p>@jobPost.Description</p>
    </div>
}

<!-- Job Windows HTML-->
<div class="modal fade" id="jobModal" tabindex="-1" role="dialog" aria-labelledby="jobModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="jobModalLabel">Add Job</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- Form for job details -->
                <form method="post" action="@Url.Action("AddJob", "Home")">
                    <div class="form-group">
                        <label for="jobTitle">Title:</label>
                        <input type="text" class="form-control" name="jobTitle" required>
                    </div>
                    <div class="form-group">
                        <label for="jobDescription">Description:</label>
                        <textarea class="form-control" name="jobDescription" required></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Job</button>
                </form>

            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            // Show the modal when the button is clicked
            $('#addJobButton').click(function () {
                $('#jobModal').modal('show');
            });

            // Handle job submission
            $('#jobModal form').submit(function (e) {
                // Prevent default form submission
                e.preventDefault();

                // Retrieve job details from the form inputs
                var title = $('#jobModal input[name="jobTitle"]').val();
                var description = $('#jobModal textarea[name="jobDescription"]').val();

                // Send the job details to the server using AJAX
                $.ajax({
                    url: '@Url.Action("AddJob", "Home")', // Use Razor syntax to generate URL for AddJob action
                    type: 'POST', // Specify the request type
                    data: { jobTitle: title, jobDescription: description }, // Pass the job details as data
                    success: function (response) {
                        // Optionally handle success response from the server
                        console.log('Job details sent successfully');
                        // Reload the page or update the UI as needed
                        location.reload(); // Reload the page to refresh job posts
                    },
                    error: function (xhr, status, error) {
                        // Optionally handle errors
                        console.error('Error sending job details:', error);
                    }
                });

                // Close the modal
                $('#jobModal').modal('hide');
            });
        });
    </script>
}